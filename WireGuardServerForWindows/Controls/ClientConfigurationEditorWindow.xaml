<Window x:Class="WireGuardServerForWindows.Controls.ClientConfigurationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WireGuardServerForWindows.Models"
        xmlns:properties="clr-namespace:WireGuardServerForWindows.Properties"
        xmlns:controls="clr-namespace:WireGuardServerForWindows.Controls"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=models:ClientConfigurationList}"
        Width="920" Height="650"
        MinWidth="820" MinHeight="560"
        Title="{x:Static properties:Resources.ClientConfiguration}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="Client devices" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Create one client for each phone, laptop, or computer that will connect. Normally you only enter a device name, save, then export a config file or show a QR code for that device."
                       TextWrapping="Wrap" Foreground="#FF54616B" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Column="0" Grid.Row="1" BorderBrush="#FFE1E6EA" BorderThickness="1" CornerRadius="6" Padding="12">
            <DockPanel>
                <Button DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,7" Content="{x:Static properties:Resources.AddClient}" Command="{Binding AddClientConfigurationCommand}"/>
                <TextBlock Text="No existing clients. Click Add Client to create the first phone, laptop, or computer profile."
                           TextWrapping="Wrap" Foreground="#FF54616B"
                           Visibility="{c:Binding '!HasClients', FalseToVisibility=Collapsed}"/>
                <ListBox ItemsSource="{Binding List}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="Name"
                         Visibility="{c:Binding HasClients, FalseToVisibility=Collapsed}"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="1" BorderBrush="#FFE1E6EA" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Select a client or click Add Client." TextWrapping="Wrap" Foreground="#FF54616B"
                           Visibility="{c:Binding 'SelectedClient == null', FalseToVisibility=Collapsed}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{c:Binding 'SelectedClient != null', FalseToVisibility=Collapsed}">
                    <controls:ConfigurationEditorControl DataContext="{Binding SelectedClient}"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Visibility="{c:Binding 'SelectedClient != null', FalseToVisibility=Collapsed}">
                    <Button Content="{x:Static properties:Resources.GenerateQrCodeAction}" Command="{Binding SelectedClient.GenerateQrCodeAction.ExecuteActionCommand}" Padding="10,6" Margin="0,0,8,0"/>
                    <Button Content="{x:Static properties:Resources.ExportConfigurationFileAction}" Command="{Binding SelectedClient.ExportConfigurationFileAction.ExecuteActionCommand}" Padding="10,6" Margin="0,0,8,0"/>
                    <Button Content="{x:Static properties:Resources.DeleteAction}" Command="{Binding SelectedClient.DeleteAction.ExecuteActionCommand}" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Margin="0,0,8,0" Padding="10,5,10,5" Content="{x:Static properties:Resources.Cancel}" Click="CancelButton_Click"/>
            <Button Padding="10,5,10,5" Content="{x:Static properties:Resources.Save}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
